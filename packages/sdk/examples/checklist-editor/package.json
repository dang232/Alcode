{
  "name": "@alcode/example-checklist-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "alcode": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "checklist-editor",
        "name": "Checklist",
        "icon": "list-check-2"
      },
      "fileEditors": [
        {
          "id": "checklist",
          "title": "Checklist",
          "match": ["*.checklist.md"],
          "entry": "editor/index.html"
        }
      ]
    }
  },
  "dependencies": {
    "@alcode/sdk": "workspace:*"
  }
}
