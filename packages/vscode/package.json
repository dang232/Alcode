{
  "name": "alcode",
  "displayName": "Alcode",
  "description": "%extension.description%",
  "version": "2.1.1",
  "publisher": "fedaykindev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dang232/Alcode.git"
  },
  "qna": "https://discord.gg/ZYRSdnwwKA",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "gpt",
    "agent",
    "coding",
    "chatgpt",
    "groq",
    "assistant",
    "opencode",
    "alcode"
  ],
  "icon": "assets/app-icon.png",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:alcode.openSidebar",
    "onCommand:alcode.attachExplorerToChat",
    "onCommand:alcode.generateCommitMessage",
    "onView:alcode.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alcode",
          "title": "Alcode",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "alcode": [
        {
          "type": "webview",
          "id": "alcode.chatView",
          "name": "%views.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "alcode.openSidebar",
        "category": "Alcode",
        "title": "%command.openSidebar.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "alcode.focusChat",
        "category": "Alcode",
        "title": "%command.focusChat.title%"
      },
      {
        "command": "alcode.restartApi",
        "category": "Alcode",
        "title": "%command.restartApi.title%"
      },
      {
        "command": "alcode.showOpenCodeStatus",
        "category": "Alcode",
        "title": "%command.showOpenCodeStatus.title%"
      },
      {
        "command": "alcode.openAgentManager",
        "category": "Alcode",
        "title": "%command.openAgentManager.title%",
        "icon": "$(repo-forked)"
      },
      {
        "command": "alcode.openActiveSessionInEditor",
        "category": "Alcode",
        "title": "%command.openActiveSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "alcode.openNewSessionInEditor",
        "category": "Alcode",
        "title": "%command.openNewSessionInEditor.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "alcode.openCurrentOrNewSessionInEditor",
        "category": "Alcode",
        "title": "%command.openCurrentOrNewSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "alcode.addToContext",
        "category": "Alcode",
        "title": "%command.addToContext.title%"
      },
      {
        "command": "alcode.addLineComment",
        "category": "Alcode",
        "title": "%command.addLineComment.title%"
      },
      {
        "command": "alcode.submitLineComment",
        "category": "Alcode",
        "title": "%command.submitLineComment.title%"
      },
      {
        "command": "alcode.removeLineComment",
        "category": "Alcode",
        "title": "%command.removeLineComment.title%",
        "icon": "$(close)"
      },
      {
        "command": "alcode.explain",
        "category": "Alcode",
        "title": "%command.explain.title%"
      },
      {
        "command": "alcode.improveCode",
        "category": "Alcode",
        "title": "%command.improveCode.title%"
      },
      {
        "command": "alcode.newSession",
        "category": "Alcode",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "alcode.showSettings",
        "category": "Alcode",
        "title": "%command.showSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "alcode.attachExplorerToChat",
        "category": "Alcode",
        "title": "%command.attachExplorerToChat.title%"
      },
      {
        "command": "alcode.generateCommitMessage",
        "category": "Alcode",
        "title": "%command.generateCommitMessage.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-scm-titlebar.svg"
        }
      }
    ],
    "submenus": [
      {
        "id": "alcode.submenu",
        "label": "Alcode"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "alcode.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "alcode.submitLineComment",
          "group": "inline",
          "when": "commentController == alcode.inlineComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "alcode.removeLineComment",
          "group": "navigation",
          "when": "commentController == alcode.inlineComments && commentThread == alcodeAttached"
        }
      ],
      "commandPalette": [
        {
          "command": "alcode.submitLineComment",
          "when": "false"
        },
        {
          "command": "alcode.removeLineComment",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "alcode.submenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "alcode.attachExplorerToChat",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "alcode.openNewSessionInEditor",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "alcode.newSession",
          "when": "view == alcode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "alcode.openCurrentOrNewSessionInEditor",
          "when": "view == alcode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "alcode.openAgentManager",
          "when": "view == alcode.chatView",
          "group": "navigation@3"
        },
        {
          "command": "alcode.showSettings",
          "when": "view == alcode.chatView",
          "group": "navigation@4"
        }
      ],
      "alcode.submenu": [
        {
          "command": "alcode.explain"
        },
        {
          "command": "alcode.improveCode"
        },
        {
          "command": "alcode.addToContext"
        },
        {
          "command": "alcode.addLineComment"
        }
      ]
    },
    "configuration": {
      "title": "Alcode",
      "properties": {
        "alcode.apiUrl": {
          "type": "string",
          "default": "",
          "description": "%configuration.apiUrl.description%"
        },
        "alcode.opencodeBinary": {
          "type": "string",
          "default": "",
          "description": "%configuration.opencodeBinary.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --main-fields=module,main",
    "build:webview": "VITE_OPENCODE_URL=/api vite build",
    "dev": "concurrently -n \"ext,web\" -c \"cyan,magenta\" \"bun run watch:extension\" \"bun run dev:webview\"",
    "dev:webview": "vite --host localhost --port 5173 --strictPort",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap --main-fields=module,main",
    "watch:webview": "vite build --watch",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "bun x eslint --ext .ts,.tsx src webview",
    "test": "node ../../scripts/run-isolated-tests.mjs src webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.2.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@alcode/ui": "workspace:*",
    "@opencode/client": "2.0.23",
    "adm-zip": "^0.6.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  }
}
