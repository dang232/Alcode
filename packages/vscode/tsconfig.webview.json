{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "@types/dom-speech-recognition",
      "node"
    ],
    "paths": {
      "@alcode/sdk": ["../sdk/src/index.ts"],
      "@alcode/sdk/schemas": ["../sdk/src/schemas.ts"],
      "@/*": ["../ui/src/*"],
      "@vscode/*": ["./webview/*"],
      "@alcode/ui/*": ["../ui/src/*"]
    }
  },
  "include": [
    "webview/**/*",
    "../ui/src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../ui/tsconfig.build.json"
    }
  ]
}
