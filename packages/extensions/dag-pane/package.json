{
  "name": "omo-dag-pane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Built-in SDK guest: DAG side pane for OmO runs (project-ide todo 13). Desktop-only surface; shipped through the built-in extension registry, no folder install.",
  "alcode": {
    "apiVersion": 1,
    "engines": {
      "alcode": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "alcode-builtin-dag-pane",
        "name": "DAG runs",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "attach": false
    }
  }
}
