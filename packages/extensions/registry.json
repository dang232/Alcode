{
  "version": 1,
  "extensions": [
    {
      "id": "openchamber-builtin-dag-pane",
      "directory": "dag-pane",
      "files": [
        "panel/index.html",
        "icon.svg"
      ],
      "build": [
        {
          "entry": "panel/main.ts",
          "out": "panel/main.js",
          "target": "browser"
        },
        {
          "entry": "service/main.js",
          "out": "service/main.js",
          "target": "node"
        }
      ]
    }
  ]
}
